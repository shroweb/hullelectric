# Google Places API — enables live Google reviews on the /reviews page.
# Without these the site uses the static reviews in src/lib/site-data.ts.
#
# 1. Go to https://console.cloud.google.com and create a project
# 2. Enable "Places API" (legacy)
# 3. Create an API key and restrict it to Places API
# 4. Find the Place ID at:
#    https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
#    Search: "Abbey Electrical Services Hull" → copy the ChIJ... value
#
# Copy this file to .env and fill in the values:

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
